# Copy this file to `.env.local` and fill in values (`.env.local` is gitignored).

# Supabase — from dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Optional: pooler URL; app can derive public Supabase URL from this when NEXT_PUBLIC_* is unset
DATABASE_URL=postgres://postgres.your-project:password@aws-0-region.pooler.supabase.com:6543/postgres

# Optional: parent domain for the auth cookie, so the session is shared with the
# other apps on this domain (set to `.tinywork.shop` in production). Also turns on
# the Secure flag. Leave EMPTY locally — a browser drops a cookie whose Domain
# doesn't match the current host, which would break login on localhost.
NEXT_PUBLIC_COOKIE_DOMAIN=

# REQUIRED. Auth user ids allowed into the board, comma-separated. Being logged
# in is not enough — every query runs as service_role, so this is the only gate
# on who gets in. Unset means nobody gets in (503), deliberately: failing open
# here would defeat the point. Server-side and read at runtime, so it must be
# set wherever the app is deployed, not only in .env.local.
ALLOWED_USER_IDS=

GOOGLE_AI_API_KEY=your_google_ai_key
POLLINATIONS_API_KEY=your_pollinations_sk_key

# Optional: long random string for POST /api/capture (iOS Shortcuts, scripts). Omit to disable the endpoint.
QUICK_CAPTURE_TOKEN=

# Optional: Bearer token for remote MCP at POST/GET/DELETE /api/mcp (Claude mobile / custom connector).
# If unset, QUICK_CAPTURE_TOKEN is reused when you want one secret for both capture and MCP.
REMOTE_MCP_TOKEN=

