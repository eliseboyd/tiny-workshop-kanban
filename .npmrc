# @eliseboyd/design is published to GitHub Packages, not npmjs.
# NPM_TOKEN is read from the environment — never write the token into this file.
# Vercel: set NPM_TOKEN in the project's environment variables (Production + Preview).
# Local: export NPM_TOKEN in your shell, or put the line in ~/.npmrc instead.
@eliseboyd:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NPM_TOKEN}
